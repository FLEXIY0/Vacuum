# Vacuum — package set installed on top of base-system.
# One package per line. '#' starts a comment. Empty lines are ignored.
#
# base-system already brings: linux, runit-void, dhcpcd, wpa_supplicant,
# iw, wifi-firmware, acpid, eudev, sudo, openssh, util-linux, kbd, xbps.

# --- graphics stack -------------------------------------------------------
# xorg-minimal pulls xorg-server + xauth + xinit + xf86-input-libinput.
xorg-minimal
mesa-dri
setxkbmap
xrandr
xsetroot
xprop
# xset drives the screen-blanking and DPMS settings in openbox/autostart.
xset

# --- desktop --------------------------------------------------------------
openbox
tint2
dunst
dmenu
st
nitrogen
feh
# Screenshots, bound to Print. 139 KB, and its only real dependency is
# imlib2, which feh has already pulled in.
scrot
pcmanfm
# The side HUD: load, memory, network and the live keybinding cheatsheet.
# ~2 MB on disk, ~10 MB resident, and Super+F1 turns it off.
conky

# --- session plumbing -----------------------------------------------------
dbus
xdg-user-dirs

# Icon themes. hicolor is the fallback every toolkit expects to exist;
# without it dunst, GTK and pcmanfm log missing-theme warnings and fall back
# to blank icons. Adwaita costs 13 MB of disk and nothing at runtime beyond
# the icons actually loaded, and it is what the GTK settings ask for.
hicolor-icon-theme
adwaita-icon-theme

# --- audio ----------------------------------------------------------------
pipewire
wireplumber
alsa-pipewire
# alsa-utils is not optional, even with PipeWire on top. The kernel brings
# an HDA codec up muted, and the thing that unmutes it is `alsactl init`,
# which lives here -- as does the runit service that restores the mixer at
# boot and saves it at shutdown. Without this package a fresh install is
# silent no matter how healthy PipeWire looks. It also supplies alsamixer,
# which is the only way to reach controls PipeWire does not expose.
alsa-utils

# --- memory + power -------------------------------------------------------
zramen
tlp

# --- fonts ----------------------------------------------------------------
# terminus for the console and st, dejavu for anything Pango-based (tint2,
# GTK). font-misc-misc supplies the X11 "fixed" fallback.
terminus-font
dejavu-fonts-ttf
font-misc-misc

# --- installer ------------------------------------------------------------
# void-installer is a shell script shipped by void-mklive, not a package; it
# needs dialog, and grub for whichever firmware the target machine uses.
dialog
grub-x86_64-efi
grub-i386-efi
xmirror
