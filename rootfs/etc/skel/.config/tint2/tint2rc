# Vacuum — tint2 panel. A 26px bar along the top: tasks, tray, battery,
# clock. Flat surfaces, one hairline under the panel, accent only on the
# active task.

#---------------------------------------------
# Backgrounds (referenced below by 1-based index)
#---------------------------------------------
# 1: the panel itself — hairline on the bottom edge, since it sits on top
rounded = 0
border_width = 1
border_sides = B
background_color = #0b0c0e 100
border_color = #262a31 100

# 2: active task — accent underline along the panel's inner edge
rounded = 0
border_width = 2
border_sides = B
background_color = #1a1d22 100
border_color = #5fb8c7 100

# 3: normal / iconified task
rounded = 0
border_width = 0
background_color = #0b0c0e 0
border_color = #0b0c0e 0

# 4: urgent task
rounded = 0
border_width = 2
border_sides = B
background_color = #1a1d22 100
border_color = #d4796a 100

# 5: tooltip
rounded = 0
border_width = 1
background_color = #131519 100
border_color = #262a31 100

#---------------------------------------------
# Panel
#---------------------------------------------
panel_items = TSEBC
panel_size = 100% 26
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 1
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_dock = 0
panel_shrink = 0
wm_menu = 1
autohide = 0
strut_policy = follow_size
font_shadow = 0
mouse_effects = 0
# The panel has no launcher, but tint2 still resolves this theme at startup
# and complains if it names one that is not installed.
launcher_icon_theme = Adwaita

#---------------------------------------------
# Taskbar
#---------------------------------------------
taskbar_mode = single_desktop
taskbar_padding = 0 0 2
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_name_padding = 8 0
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_name_font = DejaVu Sans 8
taskbar_name_font_color = #6b7280 100
taskbar_name_active_font_color = #5fb8c7 100
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

#---------------------------------------------
# Tasks
#---------------------------------------------
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 220 24
task_padding = 6 2 6
task_font = DejaVu Sans 8
task_tooltip = 1
task_font_color = #6b7280 100
task_active_font_color = #d2d6dc 100
task_urgent_font_color = #d4796a 100
task_iconified_font_color = #4b515b 100
task_background_id = 3
task_active_background_id = 2
task_urgent_background_id = 4
task_iconified_background_id = 3

#---------------------------------------------
# System tray
#---------------------------------------------
systray_padding = 6 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 16
systray_icon_asb = 100 0 0
systray_monitor = 1

#---------------------------------------------
# Volume ('E' in panel_items)
#---------------------------------------------
# Polled rather than pushed: tint2 has no way to be told the volume moved.
# Two seconds is the same beat the HUD runs at, and a key press does not
# wait for it -- vacuum-vol raises a notification immediately, so the panel
# is confirmation rather than feedback.
execp = new
execp_command = vacuum-vol --panel
execp_interval = 2
execp_continuous = 0
execp_has_icon = 0
execp_markup = 0
execp_font = DejaVu Sans Mono 8
execp_font_color = #d2d6dc 100
execp_padding = 8 0
execp_background_id = 0
execp_centered = 1
execp_tooltip = Scroll to change, click to mute, right-click for the mixer
execp_lclick_command = vacuum-vol mute
execp_rclick_command = vacuum-term -e alsamixer
execp_uwheel_command = vacuum-vol up
execp_dwheel_command = vacuum-vol down

#---------------------------------------------
# Battery (hidden entirely when there is no battery)
#---------------------------------------------
battery_tooltip = 1
battery_low_status = 15
# Not a bare notify-send: on a machine with no battery tint2 reads 0% and
# fires this immediately, so the warning has to check for real hardware
# first. See /usr/bin/vacuum-battery-warn.
battery_low_cmd = /usr/bin/vacuum-battery-warn
battery_hide = 101
bat1_font = DejaVu Sans 8
bat2_font = DejaVu Sans 7
battery_font_color = #6b7280 100
battery_padding = 6 0
battery_background_id = 0

#---------------------------------------------
# Clock
#---------------------------------------------
time1_format = %H:%M
time1_font = DejaVu Sans Mono 8
time2_format = %a %d %b
time2_font = DejaVu Sans 7
clock_font_color = #d2d6dc 100
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y

#---------------------------------------------
# Tooltips
#---------------------------------------------
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 6 4
tooltip_background_id = 5
tooltip_font_color = #d2d6dc 100
tooltip_font = DejaVu Sans 8

#---------------------------------------------
# Mouse
#---------------------------------------------
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify
