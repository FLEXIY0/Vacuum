# Vacuum — zram swap, as set up by the zramen service.
#
# Void's default is 25% of RAM with lz4. Vacuum raises the share and moves
# to zstd: on a machine with 512 MB - 2 GB of RAM the extra CPU cost of zstd
# is repaid many times over by the better ratio (roughly 3-4x on desktop
# working sets, against lz4's 2-2.5x), and the paired vm.swappiness=100 in
# /etc/sysctl.d/99-vacuum.conf means the kernel will actually use it.
#
# On a machine with plenty of RAM this costs nothing: zram allocates
# physical pages lazily, so an unused 60% device occupies almost nothing.

export ZRAM_COMP_ALGORITHM=zstd
export ZRAM_SIZE=60
export ZRAM_MAX_SIZE=8192
export ZRAM_PRIORITY=32767
export ZRAMEN_SWAPON_DISCARD=both
