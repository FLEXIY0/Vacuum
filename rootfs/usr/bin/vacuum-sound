#!/bin/sh
# Vacuum — why there is no sound, and how to fix it.
#
#   vacuum-sound           check everything and report
#   vacuum-sound --fix     apply the fixes that are safe to apply (root)
#   vacuum-sound --test    play a test tone
#
# Silence on a fresh install is almost never a missing driver. The usual
# cause is that nothing ever unmuted the card: the kernel brings an HDA
# codec up with its outputs muted and its levels at zero, and unless
# something runs `alsactl init` it stays that way -- PipeWire will happily
# report a working sink at 100% while the hardware mixer underneath is off.
#
# So this walks the whole chain, from the card the kernel found up to the
# sink PipeWire is offering, and says which link is broken rather than
# leaving you to guess.

set -eu

PROBLEMS=0
FIXABLE=""
MODE=check

for arg in "$@"; do
    case "$arg" in
        --fix)  MODE=fix ;;
        --test) MODE=test ;;
        -h|--help) sed -n '2,7p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown option: $arg" >&2; exit 1 ;;
    esac
done

if [ -t 1 ]; then
    G=$(printf '\033[1;32m'); R=$(printf '\033[1;31m')
    Y=$(printf '\033[1;33m'); C=$(printf '\033[1;36m'); N=$(printf '\033[0m')
else
    G=; R=; Y=; C=; N=
fi

section() { printf '\n%s%s%s\n' "$C" "$*" "$N"; }
ok()   { printf '  %s+%s %s\n' "$G" "$N" "$*"; }
bad()  { printf '  %s-%s %s\n' "$R" "$N" "$*"; PROBLEMS=$((PROBLEMS + 1)); }
warn() { printf '  %s~%s %s\n' "$Y" "$N" "$*"; }
info() { printf '      %s\n' "$*"; }

# The user whose session this is about: under sudo that is not the caller.
WHO="${SUDO_USER:-$(id -un)}"

# Overridable so the "a card is present" path can be exercised somewhere
# that has no sound card. That is the path this tool exists for, and it is
# the one that must not fall over halfway through the report.
ASOUND="${VACUUM_ASOUND:-/proc/asound/cards}"
PCIDEV="${VACUUM_PCI:-/sys/bus/pci/devices}"

# --- the test tone ----------------------------------------------------------
if [ "$MODE" = test ]; then
    command -v speaker-test >/dev/null 2>&1 || {
        echo "speaker-test is missing:  sudo xbps-install -S alsa-utils" >&2
        exit 1
    }

    tone() {
        if [ -n "$1" ]; then
            speaker-test -D "$1" -t sine -f 440 -l 1 -P 2 -c 2 >/dev/null 2>&1
        else
            speaker-test -t sine -f 440 -l 1 -P 2 -c 2 >/dev/null 2>&1
        fi
    }

    echo "Playing a 440 Hz tone through the default device..."
    if tone ""; then
        echo "Done -- if you heard it, the whole path works."
        exit 0
    fi

    # The default device is routed through PipeWire by /etc/alsa/conf.d, so
    # a dead PipeWire makes a perfectly good card look silent. Falling back
    # to the hardware is what separates those two, and a test that cannot
    # tell them apart is worse than no test.
    echo "The default device would not open -- that is what a stopped"
    echo "PipeWire looks like, since ALSA's default is routed through it."
    echo "Trying the card directly..."

    card=$(sed -n 's/^ *\([0-9][0-9]*\) \[.*/\1/p' "$ASOUND" 2>/dev/null |
        head -1) || card=""
    [ -n "$card" ] || { echo "No card to try." >&2; exit 1; }

    if tone "hw:$card"; then
        echo
        echo "Heard it that time? Then the card and the mixer are fine and"
        echo "the problem is PipeWire, not the hardware. It starts from"
        echo "~/.config/openbox/autostart when a desktop session begins."
        exit 0
    fi

    echo "The card would not play either. Run  vacuum-sound  for why." >&2
    exit 1
fi

# --- the hardware itself ----------------------------------------------------
# Read from sysfs rather than by running lspci: pciutils is not part of a
# Vacuum install, and the two files needed are always there. Class 0403 is
# "audio device", 0401 the older "multimedia audio controller".
pci_audio() {
    found=0
    for d in "$PCIDEV"/*; do
        [ -r "$d/class" ] || continue
        case "$(cat "$d/class" 2>/dev/null)" in
            0x0403*|0x0401*) ;;
            *) continue ;;
        esac
        found=1
        drv=""
        if [ -L "$d/driver" ]; then
            drv=$(readlink "$d/driver" 2>/dev/null) || drv=""
            drv="${drv##*/}"
        fi
        printf '      %s  [%s:%s]  driver: %s\n' "${d##*/}" \
            "$(cut -c3- "$d/vendor" 2>/dev/null)" \
            "$(cut -c3- "$d/device" 2>/dev/null)" \
            "${drv:-NONE BOUND}"
    done
    [ "$found" = 1 ] || printf '      (no PCI audio device at all)\n'
}

snd_modules() {
    mods=$(lsmod 2>/dev/null | awk '/^snd/ { printf "%s ", $1 }') || mods=""
    printf '      %s\n' "${mods:-(no snd modules loaded)}"
}

# --- 1. does the kernel see a card? -----------------------------------------
section "sound card"
CARDS=0
if [ -r "$ASOUND" ]; then
    # grep -c exits 1 when it counts nothing, and an assignment from a
    # failing command substitution aborts the script under `set -e` -- which
    # is precisely the machine this is meant to report on.
    CARDS=$(grep -c '^ *[0-9][0-9]* \[' "$ASOUND" 2>/dev/null || true)
    : "${CARDS:=0}"
fi
if [ "$CARDS" -gt 0 ]; then
    sed -n 's/^ *\([0-9][0-9]*\) \[\([^]]*\)\].*: \(.*\)/  + card \1: \3/p' \
        "$ASOUND" 2>/dev/null | sed "s/^  +/  ${G}+${N}/"
    # The codec decides which controls exist and which quirks apply, so it
    # is the single most useful line to have when a mixer looks wrong.
    for c in /proc/asound/card*/codec#*; do
        [ -r "$c" ] || continue
        sed -n 's/^Codec: /      codec: /p' "$c" 2>/dev/null
    done
else
    bad "the kernel found no sound card"
    # Everything needed to work out why, gathered here rather than left as
    # three commands to run by hand -- this is the case where the person
    # reading has the least to go on.
    info "PCI audio hardware:"
    pci_audio
    info "loaded sound modules:"
    snd_modules
    info ""
    info "A PCI device with no driver bound means the module is missing or"
    info "failed to load:   sudo modprobe snd_hda_intel   then check dmesg."
    info "No PCI audio device at all means the card is disabled in the BIOS."
    # Nothing further is meaningful.
    printf '\n%s1 problem found.%s\n' "$R" "$N"
    exit 1
fi

# /dev/snd has to be reachable by whoever is playing, and without a seat
# manager that is decided by group membership alone.
if [ -d /dev/snd ]; then
    ok "/dev/snd present"
else
    bad "/dev/snd is missing even though a card was found"
    info "The snd driver loaded but no device nodes were made; is udevd running?"
fi

# --- 2. is alsa-utils installed? --------------------------------------------
section "mixer tools"
if command -v amixer >/dev/null 2>&1; then
    ok "alsa-utils installed"
else
    bad "alsa-utils is not installed, so nothing can unmute the card"
    info "sudo xbps-install -S alsa-utils"
    FIXABLE="$FIXABLE pkg"
fi

# --- 3. is anything muted? --------------------------------------------------
if command -v amixer >/dev/null 2>&1; then
    section "mixer state"
    MUTED=$(amixer scontrols 2>/dev/null |
        sed -n "s/^Simple mixer control '\([^']*\)'.*/\1/p" |
        while read -r c; do
            amixer sget "$c" 2>/dev/null | grep -q '\[off\]' && printf '%s ' "$c"
        done)
    ZERO=$(amixer sget Master 2>/dev/null | grep -o '\[[0-9]*%\]' | head -1 |
        tr -d '[]%')

    if [ -n "$MUTED" ]; then
        bad "muted: $MUTED"
        FIXABLE="$FIXABLE unmute"
    else
        ok "nothing is muted"
    fi

    if [ -n "$ZERO" ] && [ "$ZERO" -eq 0 ] 2>/dev/null; then
        bad "Master is at 0%"
        FIXABLE="$FIXABLE unmute"
    fi

    if [ -f /var/lib/alsa/asound.state ]; then
        ok "mixer state is saved, so it survives a reboot"
    else
        warn "no saved mixer state -- settings are lost on reboot"
        FIXABLE="$FIXABLE store"
    fi
fi

# --- 4. permissions ---------------------------------------------------------
section "permissions"
if [ "$WHO" = root ]; then
    # root opens /dev/snd regardless of groups, so reporting it as a fault
    # would be simply untrue -- and this tool is worth nothing if it says
    # things that are not so.
    ok "running as root, which needs no group membership"
elif id -nG "$WHO" 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
    ok "$WHO is in the audio group"
else
    bad "$WHO is not in the audio group and cannot open /dev/snd"
    info "sudo usermod -a -G audio $WHO   (then log out and back in)"
    FIXABLE="$FIXABLE group"
fi

# --- 5. the boot-time service ----------------------------------------------
section "services"
if [ -e /var/service/alsa ]; then
    ok "the alsa service is enabled, so the mixer is restored at boot"
elif [ -d /etc/sv/alsa ]; then
    bad "the alsa service is not enabled: the card comes up muted every boot"
    info "sudo ln -s /etc/sv/alsa /var/service/alsa"
    FIXABLE="$FIXABLE service"
else
    warn "no alsa service available (alsa-utils not installed)"
fi

# --- 6. the session's audio server -----------------------------------------
section "pipewire"
PW_UP=1
for p in pipewire wireplumber; do
    if pgrep -x "$p" >/dev/null 2>&1; then
        ok "$p is running"
    else
        PW_UP=0
        bad "$p is not running"
    fi
done

if [ "$PW_UP" -eq 0 ]; then
    # Saying "PipeWire is running but has no sink" here -- which this used
    # to -- contradicts the two lines above it. A missing sink is the
    # consequence of a missing daemon, not a second fault.
    info "PipeWire is a per-user service started by the desktop session."
    info "On a tty, or under sudo from a different user, it is absent and"
    info "that is expected -- but it is not harmless:"
    info ""
    info "/etc/alsa/conf.d routes ALSA's default device through PipeWire, so"
    info "while it is down, every ALSA program fails too -- aplay,"
    info "speaker-test, anything that opens 'default'. The card is fine."
    info "vacuum-sound --test falls back to the hardware and proves it."
elif command -v wpctl >/dev/null 2>&1; then
    if wpctl get-volume @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; then
        ok "default sink: $(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
    else
        bad "PipeWire is running but offers no default sink"
        info "Usually the card is claimed by nothing PipeWire recognises."
        info "wpctl status    lists what it can see."
        info "Note that wpctl talks to the PipeWire of whoever runs it, so"
        info "as root it will not see the one in your desktop session."
    fi
fi

# --- fixing -----------------------------------------------------------------
if [ "$MODE" = fix ]; then
    section "fixing"
    if [ "$(id -u)" -ne 0 ]; then
        echo "  --fix needs root:  sudo vacuum-sound --fix" >&2
        exit 1
    fi

    case "$FIXABLE" in *pkg*)
        echo "  installing alsa-utils"
        xbps-install -Sy alsa-utils || warn "could not install alsa-utils"
        ;;
    esac

    if command -v alsactl >/dev/null 2>&1; then
        echo "  initialising the mixer from the card's profile"
        # `init` applies /usr/share/alsa/init/hda for Intel HDA codecs,
        # which is what turns the outputs on in the first place.
        alsactl init 2>/dev/null || true

        # The init profiles cover the standard controls; these are the ones
        # that are commonly separate on laptop codecs and stay off.
        for c in Master PCM Speaker Headphone Front "Front Speaker" Desktop; do
            amixer -q sset "$c" unmute  >/dev/null 2>&1 || true
        done
        for c in Master PCM Speaker Headphone Front; do
            amixer -q sset "$c" 70%     >/dev/null 2>&1 || true
        done
        echo "  saving mixer state"
        mkdir -p /var/lib/alsa
        alsactl store 2>/dev/null || true
    fi

    if [ ! -e /var/service/alsa ] && [ -d /etc/sv/alsa ]; then
        echo "  enabling the alsa service"
        ln -sf /etc/sv/alsa /var/service/alsa
    fi

    case "$FIXABLE" in *group*)
        echo "  adding $WHO to the audio group"
        usermod -a -G audio "$WHO" || warn "could not change groups for $WHO"
        echo "  $WHO must log out and back in for that to take effect"
        ;;
    esac

    printf '\n%sDone. Test it with:%s  vacuum-sound --test\n' "$C" "$N"
    exit 0
fi

# --- summary ----------------------------------------------------------------
if [ "$PROBLEMS" -eq 0 ]; then
    printf '\n%sEverything checks out.%s If it is still silent, the output may be\n' "$G" "$N"
    printf 'going to the wrong jack: run  alsamixer  and look at the levels.\n'
else
    printf '\n%s%d problem(s) found.%s Most of this can be fixed with:\n' \
        "$R" "$PROBLEMS" "$N"
    printf '\n    sudo vacuum-sound --fix\n'
    exit 1
fi
