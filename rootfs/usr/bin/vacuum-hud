#!/bin/sh
# Vacuum — show or hide the side HUD (conky).
#
#   vacuum-hud            toggle          (bound to Super+F1)
#   vacuum-hud on|off
#   vacuum-hud status
#
# Whether it was on is remembered, so the session comes back the way you
# left it rather than the way the defaults say.

set -eu

STATE="${XDG_CONFIG_HOME:-$HOME/.config}/vacuum"
FLAG="$STATE/hud-off"

# A dead-but-unreaped conky still answers to pgrep, and treating that as
# "already running" leaves the HUD permanently missing with no error. Ask
# the kernel for the state and ignore zombies.
running() {
    for p in $(pgrep -x conky 2>/dev/null); do
        state=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f1)
        [ "$state" = Z ] || return 0
    done
    return 1
}

start() {
    command -v conky >/dev/null 2>&1 || {
        echo "conky is not installed:  sudo xbps-install -S conky" >&2
        exit 1
    }
    running || conky -q -d >/dev/null 2>&1
    mkdir -p "$STATE"
    rm -f "$FLAG"
}

stop() {
    pkill -x conky 2>/dev/null || true
    mkdir -p "$STATE"
    : > "$FLAG"
}

case "${1:-toggle}" in
    on)      start ;;
    off)     stop ;;
    toggle)  if running; then stop; else start; fi ;;
    status)  if running; then echo "on"; else echo "off"; fi ;;
    # Used by the session autostart: start unless it was switched off.
    restore) [ -f "$FLAG" ] || start ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \?//' ;;
    *)       echo "usage: ${0##*/} [on|off|toggle|status]" >&2; exit 1 ;;
esac
