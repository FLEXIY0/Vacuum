# Build output — ISOs are far too large for git; the Actions workflow
# publishes them as release assets instead.
/out/
*.iso
*.iso.sha256

# Scratch space used by mk/build-in-container.sh when run natively.
/build/
/xbps-cachedir-*/

# Preview renders from ./preview.sh — regenerate them, don't commit them.
# (docs/preview.png is committed on purpose, as the README's screenshot.)
/preview/
